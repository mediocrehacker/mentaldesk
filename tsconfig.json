{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
, "app/worksheets/page.tsx~", "app/oprosniki/[slug]/page.tsx~", "app/oprosniki/page.tsx~", "app/oprosniki/page.tsx~", "app/worksheets/[slug]/page.tsx~", "app/components/ToolCard.tsx~", "app/search/page.tsx~", ".next/dev/types/validator.ts~"  ],
  "exclude": ["node_modules"]
}
